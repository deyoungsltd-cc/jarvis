# =============================================================================
# OpenJarvis API — Environment Variables
# Copy to .env and fill in values.
# =============================================================================

# ---- Server ----
PORT=3001
WS_PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# ---- Database ----
DATABASE_URL=file:./prisma/prisma/dev.db

# ---- Admin Auth ----
ADMIN_PASSWORD_HASH=

# ---- Cloud Model Providers ----
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Local LLM (cross-platform: Ollama / LM Studio / mlx-vlm) ----
# Leave blank to auto-detect (probes Ollama:11434, LM Studio:1234, mlx-vlm:8080)
LOCAL_LLM_BASE_URL=
# Leave blank to auto-detect from server. Set explicitly if needed.
LOCAL_LLM_MODEL=
# Generation parameters
LOCAL_LLM_TEMPERATURE=0.7
LOCAL_LLM_MAX_TOKENS=4096
# Timeout in ms (local inference is slower than cloud)
LOCAL_LLM_TIMEOUT_MS=300000

# ---- Web Search ----
TAVILY_API_KEY=
SEARXNG_BASE_URL=http://localhost:8080

# ---- Voice ----
PORCUPINE_ACCESS_KEY=
HEYGEN_API_KEY=
GROQ_VOICE_API_KEY=

# ---- Service Manager ----
COMPOSE_DIR=./compose
BACKUP_DIR=./backups
DOCKER_COMPOSE_CMD=docker compose
