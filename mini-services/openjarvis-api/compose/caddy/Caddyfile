# ============================================================
# Phase 16 — Caddy Reverse Proxy
# Tailscale-only binding: all services reachable only via
# the Tailscale mesh network, never from the public internet.
# ============================================================

# Bind to Tailscale interface only (100.x.x.x)
# This is the single biggest security measure:
# Vaultwarden, Nextcloud, Home Assistant, and all other
# admin panels are NEVER exposed to the raw internet.
{
	# If Tailscale IP is known, bind to it specifically.
	# Otherwise, use 0.0.0.0 and rely on Tailscale ACLs + firewall.
	# Production: replace with your actual Tailscale IP.
	# admin off
}

# ===== Group A — Apps Big Tech Sells You =====

pdf.internal {
	reverse_proxy stirling-pdf:8080
}

