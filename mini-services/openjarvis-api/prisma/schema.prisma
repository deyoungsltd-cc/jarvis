// ===========================================
// DATABASE PROVIDER CONFIGURATION
// ===========================================
//
// Prisma's `provider` field is a BUILD-TIME setting — it cannot be
// changed dynamically at runtime. To switch database backends:
//
//   1. Set DATABASE_PROVIDER in your .env (sqlite | postgresql | mysql)
//   2. Set DATABASE_URL to your connection string
//   3. Change the `provider` value below to match your choice:
//        - "sqlite"    → for SQLite (file:./prisma/dev.db)
//        - "postgresql" → for PostgreSQL (postgresql://user:pass@host:port/db)
//        - "mysql"      → for MySQL (mysql://user:pass@host:port/db)
//   4. Run: npx prisma generate
//   5. Run: npx prisma db push
//
// The application validates DATABASE_PROVIDER and DATABASE_URL at
// startup via src/utils/database.ts and logs the active provider.
//
// SQLite-specific notes:
//   - No extra setup required; the database file is created automatically.
//   - Good for development and single-instance deployments.
//
// PostgreSQL-specific notes:
//   - Requires a running PostgreSQL server.
//   - Recommended for production multi-instance deployments.
//   - Supports concurrent writes without locking issues.
//
// MySQL-specific notes:
//   - Requires a running MySQL server.
//   - Use mysql:// protocol in DATABASE_URL.
//   - Ensure the database charset is utf8mb4 for full Unicode support.
// ===========================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===========================================
// Core Tables — match the Phase 1 spec exactly
// ===========================================

model Mission {
  id        String   @id @default(uuid())
  owner     String   @default("default")
  goal      String
  status    String   @default("draft") // draft|queued|running|waiting_approval|paused|blocked|failed|completed|cancelled|expired
  plan      String?  // JSON string — stored as text in SQLite, parsed in app layer
  riskLevel String?  @default("low") // low|medium|high|critical
  budget    Int      @default(100000) // max token budget
  maxToolCalls Int   @default(50) // max tool calls per mission
  toolCallCount Int  @default(0) // actual tool calls made
  tokenUsage    Int  @default(0) // approximate tokens consumed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events  MissionEvent[]
  memories MemoryEntry[]

  @@map("missions")
}

model MissionEvent {
  id        String   @id @default(uuid())
  missionId String
  type      String   // interpret|context_retrieval|plan|risk_check|tool_select|tool_execute|observe|verify|memory_update|adapt|escalate|complete|error|budget_exceeded
  payload   String?  // JSON string
  createdAt DateTime @default(now())

  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
  @@map("mission_events")
}

model Tool {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  inputSchema String?  // JSON string — JSON Schema for tool input
  outputSchema String? // JSON string — JSON Schema for tool output
  riskLevel   String   @default("low") // low|medium|high|critical
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("tools")
}

model MemoryEntry {
  id            String   @id @default(uuid())
  scope         String   // working|episodic|semantic|preference|project
  key           String
  value         String?  // JSON string
  tags          String?  // JSON array string — e.g. ["python", "debugging"]
  missionId     String?  // link to mission that created this memory
  source        String   @default("agent") // agent|user|system|import
  importance    Int      @default(3) // 1-5 scale, 5 = most important
  accessCount   Int      @default(0)
  lastAccessedAt DateTime? // updated on each recall
  expiresAt     DateTime? // null = never expires
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mission      Mission?              @relation(fields: [missionId], references: [id], onDelete: SetNull)
  associations MemoryAssociation[]     @relation("Associations")
  reverseAssociations MemoryAssociation[] @relation("ReverseAssociations")

  @@index([scope])
  @@index([key])
  @@index([missionId])
  @@index([importance])
  @@map("memory_entries")
}

model MemoryAssociation {
  id              String   @id @default(uuid())
  fromMemoryId    String
  toMemoryId      String
  strength        Float    @default(1.0) // 0.0-1.0 association strength
  createdAt       DateTime @default(now())

  from MemoryEntry @relation("Associations", fields: [fromMemoryId], references: [id], onDelete: Cascade)
  to   MemoryEntry @relation("ReverseAssociations", fields: [toMemoryId], references: [id], onDelete: Cascade)

  @@unique([fromMemoryId, toMemoryId])
  @@index([fromMemoryId])
  @@index([toMemoryId])
  @@map("memory_associations")
}

model MobileClient {
  id          String    @id @default(uuid())
  name        String
  platform    String    // ios|android|web
  apiKey      String    @unique
  enabled     Boolean   @default(true)
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([apiKey])
  @@index([platform])
  @@map("mobile_clients")
}

// ===========================================
// Phase 10 — Approval Workflow & Human-in-the-Loop
// ===========================================

model ApprovalRequest {
  id          String   @id @default(uuid())
  missionId   String
  toolName    String   // tool being requested
  capability  String?  // capability being checked (for permission-gated tools)
  riskLevel   String   @default("medium") // low|medium|high|critical
  status      String   @default("pending") // pending|approved|rejected|expired|cancelled
  reason      String?  // human-readable reason for the request
  toolInput   String?  // JSON string — the tool's input arguments
  resolvedBy  String?  // who approved/rejected (user identifier)
  resolvedAt  DateTime? // when the decision was made
  response    String?  // optional response message from the approver
  expiresAt   DateTime? // auto-expire if not decided within this time
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([missionId])
  @@index([status])
  @@index([riskLevel])
  @@index([expiresAt])
  @@map("approval_requests")
}

// ===========================================
// Phase 10 — Authorization Model: Capability Registry
// "The admin is the policy" — flat, admin-editable list.
// Undefined ≠ denied: undefined pauses and asks.
// Separate from tools table; grants persist independently.
// ===========================================

model CapabilityGrant {
  id          String   @id @default(uuid())
  capability  String   // capability_id — e.g. "filesystem_write", "shell_execute"
  allowed     Boolean  @default(true) // true=granted, false=explicitly denied
  scopeType   String   @default("permanent") // permanent|mission|session
  scopeContext String?  // JSON string — optional scope constraint (e.g. {"pathPrefix":"/projects/"})
  missionId   String?  // for mission-scoped grants
  source      String   @default("manual") // manual|approval_always_allow
  approvalRequestId String? // link back to the approval that created this grant
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([capability])
  @@index([allowed])
  @@index([scopeType])
  @@map("capability_grants")
}

model ApprovalRule {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  enabled     Boolean  @default(true)
  // Rule conditions
  matchRiskLevels  String?  // JSON array: ["low","medium"] — which risk levels this rule applies to
  matchToolNames   String?  // JSON array: ["web_search"] — specific tool names (or patterns with *)
  matchCapabilities String?  // JSON array: ["filesystem_read"] — specific capabilities
  // Rule action
  action      String   @default("auto_approve") // auto_approve|auto_reject|require_manual
  priority    Int      @default(0) // higher priority rules evaluated first
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("approval_rules")
}

model McpServer {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  transport   String   // "stdio" | "sse" | "in-process"
  command     String?  // for stdio: executable path
  args        String?  // for stdio: JSON array string of args
  url         String?  // for sse: server URL
  env         String?  // JSON object string of env vars for stdio
  enabled     Boolean  @default(true)
  status      String   @default("disconnected") // disconnected|connecting|connected|error
  lastError   String?
  toolCount   Int      @default(0)
  connectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tools       McpTool[]

  @@index([status])
  @@index([enabled])
  @@map("mcp_servers")
}

model McpTool {
  id          String    @id @default(uuid())
  serverId    String
  name        String    // e.g. "mcp__servername__toolname"
  mcpName     String    // original tool name from MCP server
  description String?
  inputSchema String?   // JSON string — JSON Schema
  riskLevel   String    @default("medium") // MCP tools default to medium risk
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  server      McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, mcpName])
  @@index([serverId])
  @@index([name])
  @@map("mcp_tools")
}

// ===========================================
// Phase 16 — Sovereign Stack: Service Instance Registry
// Tracks all deployed Docker services, their lifecycle
// state, and audit trail.
// ===========================================

model ServiceInstance {
  id          String   @id @default(uuid())
  name        String   @unique  // e.g. "immich", "vaultwarden", "searxng"
  displayName String              // e.g. "Immich (Google Photos)"
  group       String              // "A" | "B" | "C" | "D" — deployment group
  repoUrl     String?             // e.g. "immich-app/immich"
  replaces    String?             // e.g. "Google Photos"
  hostname    String?             // e.g. "photos.internal" — Caddy internal hostname
  composePath String              // path to the group's docker-compose.yml
  serviceName String              // the docker-compose service name
  imageTag    String              // e.g. "ghcr.io/immich-app/immich-server:v1.100.0"
  status      String   @default("not_deployed") // not_deployed|deploying|running|stopped|updating|error|rollback
  healthStatus String @default("unknown") // unknown|healthy|unhealthy|degraded
  healthUrl   String?             // e.g. "http://immich-server:2283/api/status"
  resourceWeight String @default("lightweight") // lightweight|moderate|heavy
  lastHealthCheck DateTime?
  lastDeployedAt DateTime?
  lastUpdatedAt  DateTime?
  deployedImageTag String?        // the actually-running image tag (for rollback)
  rollbackImageTag String?        // the previous known-good image tag
  error       String?             // last error message
  mobileApp   String?             // e.g. "Immich" — name of the official mobile app
  mobileAppNote String?           // pairing instructions
  port        Int?                // internal container port
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  backups ServiceBackup[]

  @@index([group])
  @@index([status])
  @@index([healthStatus])
  @@map("service_instances")
}

model ServiceBackup {
  id            String   @id @default(uuid())
  serviceInstanceId String
  filename      String              // backup file name
  filePath      String              // absolute path to backup file
  sizeBytes     Int      @default(0)
  scheduleType  String   @default("manual") // manual|daily|weekly
  storageLocation String @default("local") // local|external|nextcloud
  storageTarget String?             // e.g. "/mnt/backup" or "nextcloud:/Backups/vaultwarden"
  verified      Boolean  @default(false) // has this backup been restore-tested?
  restoredFrom  Boolean  @default(false) // was this backup used for a successful restore?
  serviceStatusAtBackup String?    // status of service when backup was taken
  createdAt     DateTime @default(now())

  service ServiceInstance @relation(fields: [serviceInstanceId], references: [id], onDelete: Cascade)

  @@index([serviceInstanceId])
  @@index([scheduleType])
  @@map("service_backups")
}

// ===========================================
// Round 2 — Document/RAG Pipeline
// ===========================================

model Document {
  id          String   @id @default(uuid())
  filename    String
  mimeType    String
  sizeBytes   Int      @default(0)
  chunkCount  Int      @default(0)
  textHash    String?
  uploadedBy  String   @default("default")
  missionId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  chunks      DocumentChunk[]

  @@map("documents")
}

model DocumentChunk {
  id          String   @id @default(uuid())
  documentId  String
  chunkIndex  Int
  content     String
  tokenCount  Int      @default(0)
  createdAt   DateTime @default(now())

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}

// ===========================================
// Round 3 — Mobile Push Notifications
// ===========================================

model Notification {
  id          String   @id @default(uuid())
  clientId    String?
  title       String
  body        String
  type        String   @default("info")
  data        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@index([read])
  @@map("notifications")
}
