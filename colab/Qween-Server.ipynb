    "# @title Step 3: Start Cloudflare Tunnel (get your public URL)\n    "import subprocess, time, re, os\n",
    "\n",
    "# Kill any existing cloudflared\n",
    "os.system('pkill cloudflared 2>/dev/null')\n",
    "time.sleep(1)\n",
    "\n",
    "# Start tunnel in background, pointing to port 8080\n",
    "proc = subprocess.Popen(\n",
    "    ['/usr/local/bin/cloudflared', 'tunnel', '--url', 'http://localhost:8080', '--no-autoupdate'],\n",
    "    stdout=subprocess.PIPE, stderr=subprocess.STDOUT\n",
    "    text=True\n",
    ")\n",
    "\n",
    "# Wait for tunnel URL\n",
    "tunnel_url = None\n",
    "for i in range(30):\n",
    "    line = proc.stdout.readline()\n",
    "    if 'trycloudflare.com' in line:\n",
    "        match = re.search(r'https://[a-z0-9-]+\.trycloudflare\.com', line)\n",
    "        if match:\n",
    "            tunnel_url = match.group(0)\n",
    "            break\n",
    "    time.sleep(1)\n",
    "\n",
    "if tunnel_url:\n",
    "    print(f'\n🎯 YOUR QWEEN SERVER URL:')\n",
    "    print(f'\n   {tunnel_url}')\n",
    "    print(f'\n   Copy this URL into your JARVIS Settings or Vercel env as:')\n",
    