# ─── OpenJARVIS Configuration ──────────────────────────────

# Database (SQLite default, switch to postgresql or mysql)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/openjarvis"
# DATABASE_URL="mysql://user:password@localhost:3306/openjarvis"

# LLM Providers
GEMINI_API_KEY=""
GROQ_API_KEY=""
# Local Qwen3.8-27B-Uncensored endpoint (Ollama/LM Studio)
LOCAL_LLM_BASE_URL="http://localhost:11434"
LOCAL_LLM_MODEL="qwen3.8:27b"

# Provider priority (comma-separated, first match wins)
LLM_PROVIDER_PRIORITY="gemini,groq,local"

# Auth
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_ACCESS_EXPIRY="1h"
JWT_REFRESH_EXPIRY="30d"

# Encryption Vault
VAULT_ENCRYPTION_KEY="change-me-to-a-32-byte-hex-string"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# Voice (Web Speech API — no key needed; or configure external providers)
# DEEPGRAM_API_KEY=""
# ELEVENLABS_API_KEY=""

# Wake Word
WAKE_WORD="Hey JARVIS"
WAKE_WORD_SENSITIVITY="0.8"

# Agent Daemon
DAEMON_WS_URL="ws://localhost:3001/daemon/ws"
DAEMON_AUTH_TOKEN=""

# Server
PORT="3001"
NODE_ENV="development"

# ─── Auth (NextAuth) ───────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"

# Google OAuth — get from https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 3. Set NEXT_PUBLIC_GOOGLE_ENABLED="true" to show the Google button on login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="true"

# Apple Sign-In — get from https://developer.apple.com/sign-in-with-apple/
# 1. Create a Services ID in your Apple Developer account
# 2. Configure redirect URL: https://your-domain.com/api/auth/callback/apple
# 3. Generate a client secret (JWT signed with your .p8 key)
# 4. Set NEXT_PUBLIC_APPLE_ENABLED="true" to show the Apple button on login
APPLE_ID=""
APPLE_SECRET=""
NEXT_PUBLIC_APPLE_ENABLED="true"

# GitHub OAuth (optional)
GITHUB_ID=""
GITHUB_SECRET=""
